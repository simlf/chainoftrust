{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chainoftrust",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Required by @anthropic-ai/sdk, whose credential-resolution code imports
  // node:path and node:fs. Neither is reachable on the one code path we use.
  "compatibility_flags": ["nodejs_compat"],

  // No "limits" block: the Free plan rejects it outright (Cloudflare error
  // 100328, "CPU limits are not supported for the Free plan") and its own
  // native caps (10ms CPU, 50 subrequests) are already stricter than the
  // 10000ms/60 this block would have declared, so the guard is redundant on
  // this plan. See docs/cloudflare-spend-controls.md.
  "observability": {
    "enabled": true
  },

  // Self-hosted fonts (public/fonts/*.woff2). Requests matching a file here
  // are served as static assets before the Worker runs; everything else still
  // reaches the Worker. Keeps the pages at zero third-party requests.
  "assets": {
    "directory": "public"
  },

  "vars": {
    // Monthly ceiling on model spend, in US cents. When the running total for
    // the current UTC month reaches this, the write-up is skipped and the
    // deterministic verdict is served without prose. Never refuses service.
    "MODEL_BUDGET_CENTS_PER_MONTH": "300",

    // Small model for the write-up. The findings come from the deterministic
    // collectors; the model only weighs and explains them. With an
    // OPENROUTER_API_KEY set this must be an OpenRouter model id (for example
    // "anthropic/claude-haiku-4.5"); with only an ANTHROPIC_API_KEY it is an
    // Anthropic model id. Switching models is a config change, not a deploy.
    "MODEL_ID": "claude-haiku-4-5",

    // Optional companions to MODEL_ID, absent by default:
    //   OPENROUTER_BASE_URL     - where the OpenAI-compatible summary call
    //                             goes when OPENROUTER_API_KEY is set. Defaults
    //                             to https://openrouter.ai/api/v1. Pointing it
    //                             elsewhere is an egress decision.
    //   MODEL_RATE_MICRO_CENTS  - "input,output" token rate in micro-cents for
    //                             the budget guard. The built-in table only
    //                             knows Anthropic models and prices anything
    //                             else pessimistically, so set this when
    //                             MODEL_ID names a model it does not know.

    // Fresh analyses per IP per UTC day. A cache hit never counts against this,
    // though it still spends one of the separate daily submission units. Only
    // the GET verdict URLs are unlimited. See README, "Cost controls".
    "FRESH_ANALYSES_PER_IP_PER_DAY": "5",

    "CONTACT_EMAIL": "lefournsimon@gmail.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chainoftrust",
      // Replace with the id printed by `wrangler d1 create chainoftrust`.
      // This is the only value that cannot be committed ahead of time.
      "database_id": "482d2ae7-3a2c-4637-b8b7-7b1d71ca4f76",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets, set with `wrangler secret put <NAME>`, never committed:
  //   OPENROUTER_API_KEY - enables the write-up via OpenRouter (or any
  //                        OpenAI-compatible endpoint named by
  //                        OPENROUTER_BASE_URL). Wins over ANTHROPIC_API_KEY
  //                        when both are set.
  //   ANTHROPIC_API_KEY  - enables the write-up via the Anthropic API. With
  //                        neither key every verdict degrades to
  //                        deterministic-only, which is a supported mode, not
  //                        an outage.
  //   GITHUB_TOKEN       - optional. Raises the GitHub API rate limit from 60
  //                        to 5000 requests/hour. Use a token with no scopes.
  //   RATE_LIMIT_SALT    - optional. Salts the rate limiter's IP digests.
  //                        Absent, they are salted with the UTC day alone,
  //                        which rotates them daily but leaves them
  //                        enumerable by anyone who can read the table.
}
