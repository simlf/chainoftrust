{
  "name": "chainoftrust",
  "version": "0.1.0",
  "private": true,
  "description": "Install-time trust reports for agent-facing tooling",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply chainoftrust --local",
    "db:migrate:remote": "wrangler d1 migrations apply chainoftrust --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
